<mxfile host="app.diagrams.net">
  <diagram id="gotham-algorithm" name="GOTHAM algorithm">
    <mxGraphModel dx="3169" dy="1684" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1630" background="#FFFFFF" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFFFF;fontColor=#233247;fontSize=24;align=center;verticalAlign=middle;spacing=8;text;strokeColor=none;fillColor=none;" value="$$\textbf{GOTHAM: iterative Wiener-system identification}$$" vertex="1">
          <mxGeometry height="50" width="660" x="342" y="20" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=20;align=center;verticalAlign=middle;spacing=8;ellipse;perimeter=ellipsePerimeter;" value="$$\text{Start}$$" vertex="1">
          <mxGeometry height="60" width="200" x="600" y="95" as="geometry" />
        </mxCell>
        <mxCell id="model" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFFFF;fontColor=#233247;fontSize=18;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Select model parametrization}\\[3pt]&lt;br&gt;\mathcal W_{\mathrm{PL}}^{(k)}(\theta)=\widehat\Phi^{(k)}\theta&lt;br&gt;\quad\text{or}\quad \mathcal W_{\mathrm{FSM}}(\theta)\end{gathered}$$" vertex="1">
          <mxGeometry height="130" width="550" x="95" y="230" as="geometry" />
        </mxCell>
        <mxCell id="loss" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFFFF;fontColor=#233247;fontSize=17;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Select matching loss functional}\\[3pt]&#xa;J_{\mathrm{PL}}^{(k)}(\theta)=\tfrac12\|C-\widehat\Phi^{(k)}\theta\|_2^2\\&#xa;J_{\nu,\mathrm{FSM}}(\theta)=\tfrac12\sum_t r_{\nu,\mathrm{FSM}}(t;\theta)^2&#xa;\end{gathered}$$" vertex="1">
          <mxGeometry height="130" width="550" x="755" y="230" as="geometry" />
        </mxCell>
        <mxCell id="root" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=19;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Choose inverse-problem formulation}\\[7pt]\begin{array}{ccc}\text{gradient-root}&amp;\text{or}&amp;\text{loss-root}\\[6pt]\mathcal N_{\mathrm G}(\theta)=\nabla_\theta J(\theta)&amp;\text{or}&amp;\mathcal N_{\mathrm L}(\theta)=J(\theta)-\varepsilon_0\end{array}\end{gathered}$$" vertex="1">
          <mxGeometry height="150" width="740" x="330" y="431" as="geometry" />
        </mxCell>
        <mxCell id="zode" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFFFF;fontColor=#233247;fontSize=19;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Set up the zero-order deformation equation}\\[5pt]&lt;br&gt;(1-q)\,\mathcal L\!\left(\phi(q)-\theta_0\right)&lt;br&gt;=q\,\hbar\,H\,\mathcal N\!\left(\phi(q)\right)\\[4pt]&lt;br&gt;\text{Choose }\mathcal L,\mathcal L^\dagger,H,\hbar,\widehat\theta^{(0)},M,K,\delta_{\mathrm{stop}}&lt;br&gt;\end{gathered}$$" vertex="1">
          <mxGeometry height="155" width="850" x="275" y="640" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=20;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}k\leftarrow0,\quad&#xa;\theta_0^{(k)}\leftarrow\widehat\theta^{(k)},\quad m\leftarrow1&#xa;\end{gathered}$$" vertex="1">
          <mxGeometry height="75" width="550" x="425" y="845" as="geometry" />
        </mxCell>
        <mxCell id="outer_test" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFDF5;fontColor=#233247;fontSize=18;align=center;verticalAlign=middle;spacing=8;rhombus;perimeter=rhombusPerimeter;" value="$$\begin{gathered}k\ge K\;\text{or}\\&#xa;\|N(\widehat\theta^{(k)})\|\le\delta_{\mathrm{stop}}\,?&#xa;\end{gathered}$$" vertex="1">
          <mxGeometry height="150" width="390" x="505" y="975" as="geometry" />
        </mxCell>
        <mxCell id="finish" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=18;align=center;verticalAlign=middle;spacing=8;ellipse;perimeter=ellipsePerimeter;" value="$$\begin{gathered}\text{Return}\\&#xa;\widehat\theta^{(k)}\end{gathered}$$" vertex="1">
          <mxGeometry height="75" width="230" x="1080" y="1013" as="geometry" />
        </mxCell>
        <mxCell id="inner_test" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFDF5;fontColor=#233247;fontSize=22;align=center;verticalAlign=middle;spacing=8;rhombus;perimeter=rhombusPerimeter;" value="$$m&gt;M\,?$$" vertex="1">
          <mxGeometry height="140" width="380" x="510" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="update" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=17;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Update parameter estimate}\\[4pt]\widehat\theta^{(k+1)}\leftarrow&lt;br&gt;\sum_{j=0}^{M}\theta_j^{(k)}\\[4pt]&lt;br&gt;k\leftarrow k+1,\quad\theta_0^{(k)}\leftarrow\widehat\theta^{(k)},\quad m\leftarrow1&lt;br&gt;\end{gathered}$$" vertex="1">
          <mxGeometry height="176" width="350" x="55" y="1172" as="geometry" />
        </mxCell>
        <mxCell id="hode" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#FFFFFF;fontColor=#233247;fontSize=18;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$\begin{gathered}\text{Solve the }m\text{-th HODE}\\[3pt]&lt;br&gt;R_m^{(k)}=\mathscr D_{m-1}\!\left(\mathcal N\!\left(\phi^{(k)}\right)\right)\\[3pt]&lt;br&gt;\theta_m^{(k)}=\chi_m\theta_{m-1}^{(k)}+&lt;br&gt;\mathcal L^\dagger\!\left(\hbar H R_m^{(k)}\right)&lt;br&gt;\end{gathered}$$" vertex="1">
          <mxGeometry height="145" width="650" x="375" y="1400" as="geometry" />
        </mxCell>
        <mxCell id="increment" parent="1" style="whiteSpace=wrap;html=1;strokeColor=#233247;strokeWidth=2;fillColor=#EFF6FC;fontColor=#233247;fontSize=19;align=center;verticalAlign=middle;spacing=8;rounded=0;" value="$$m\leftarrow m+1$$" vertex="1">
          <mxGeometry height="65" width="225" x="1085" y="1440" as="geometry" />
        </mxCell>
